{
  "name": "x-scanner",
  "version": "0.6.3",
  "private": true,
  "description": "Chrome extension that labels every post you scroll past on X using TypeSafe's Jev, with a live cost counter in the corner.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:chromium": "node build.mjs --target chromium",
    "build:firefox": "node build.mjs --target firefox",
    "build:e2e": "node build.mjs --e2e",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:e2e": "node build.mjs --e2e && node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "validate:artifacts": "node scripts/validate-artifacts.mjs",
    "calibrate": "node scripts/calibrate.ts",
    "package": "npm run package:chromium",
    "package:chromium": "npm run build:chromium && node scripts/package.mjs chromium",
    "package:firefox": "npm run build:firefox && node scripts/package.mjs firefox",
    "screenshots": "node build.mjs --e2e && node scripts/store-screenshots.ts",
    "icons": "python3 scripts/icons.py"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
